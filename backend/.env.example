# Copy this file to .env and fill in your API keys.
# .env is gitignored and will never be committed.

# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Fact Check Tools API key — https://console.cloud.google.com/
GFCT_API_KEY=your_google_fact_check_api_key_here

# MongoDB — source reliability rating (FR5) + assessment history.
# Leave blank to disable: the app still runs, source rating just shows as "unrated".
# Local install : mongodb://localhost:27017
# MongoDB Atlas : mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGODB_URI=
MONGODB_DB=misinfo_detector
